#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(КассаККМ)  Тогда
		
		ДанныеКассовойСмены = ОбщегоНазначенияРМК.ПолучитьДанныеКассовойСмены(, КассаККМ);
		
		Если НЕ ДанныеКассовойСмены.СменаОткрыта Тогда
			ТекстОшибки = НСтр("ru = 'Кассовая смена не открыта'");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,, "КассаККМ",, Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Оплата.Итог("Сумма") <> ПозицииЧека.Итог("СуммаСоСкидками") Тогда
		ТекстОшибки = НСтр("ru = 'Сумма оплат не равна сумме позиций чека'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,, "Оплата",, Отказ);
	КонецЕсли;
	
	Если РасчетВИнтернете Тогда
		
		ОтборНаличные = Новый Структура("ТипОплаты", Перечисления.ТипыОплатыККТ.Наличные);
		Если Оплата.НайтиСтроки(ОтборНаличные).Количество() > 0 Тогда
			ТекстОшибки = НСтр("ru = 'При расчете в интернете недопустимо указание наличных видов оплат'");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,, "Оплата",, Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПокупательEmail) И Не ЗначениеЗаполнено(ПокупательНомер) Тогда
			ТекстОшибки = НСтр("ru = 'При расчете в интернете необходимо указание телефона или адреса электронной почты покупателя.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,, "ПокупательEmail",, Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	Если НеприменениеККТ Тогда
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, "ДополнительныйРеквизит");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьНаОсновании(Отказ) Экспорт
	
	ФискальнаяОперация = ДанныеФискальнойОперации(ДокументОснование);
	
	Если ФискальнаяОперация = Неопределено Тогда
		
		ТекстСообщения = НСтр("ru = 'Нет сохраненной фискальной операции для документа %1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ДокументОснование);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		Отказ = Истина;
		Возврат;
		
	ИначеЕсли ФискальнаяОперация.ЕстьКорректирующийДокумент Тогда
		
		ТекстСообщения = НСтр("ru = 'По данному документу ранее была создана корректировка документом %1.
			|Создание повторной корректировки невозможно.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, 
			ФискальнаяОперация.ПредставлениеКорректирующегоДокумента);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		Отказ = Истина;
		Возврат;
		
	Иначе
		
		Если ДокументОснование <> ФискальнаяОперация.ДокументОснование Тогда
			
			ТекстСообщения = НСтр("ru = 'Данные заполнены из документа %1, т.к. он является последним корректирующим документом для документа расчетов %2.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, 
																					 ФискальнаяОперация.ДокументОснование, 
																					 ФискальнаяОперация.ДокументРасчетов);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ФискальнаяОперация);
	
	Ответственный 			= Пользователи.ТекущийПользователь();
	ДатаКоррекции 			= ФискальнаяОперация.ДатаКоррекции;
	ДополнительныйРеквизит 	= ФискальнаяОперация.ФискальныйПризнак;
	ОбщиеПараметры          = Неопределено;
	
	Если ФискальнаяОперация.ОбщиеПараметры = Неопределено Тогда
		Если ЗначениеЗаполнено(ФискальнаяОперация.ДанныеXML) Тогда
			ДанныеXMLКорректируемогоЧека = ФискальнаяОперация.ДанныеXML.Получить();
		КонецЕсли;
		ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьОбщиеПараметрыЧекаКоррекцииПоДаннымФискальнойОперации(
			ОбщиеПараметры, ФискальнаяОперация);
	Иначе
		ОбщиеПараметры = ФискальнаяОперация.ОбщиеПараметры;
		НеприменениеККТ = Истина;
		ОписаниеКоррекции = НСтр("ru = 'Неприменение ККТ'");
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ОбщиеПараметры, "СистемаНалогообложения,
														 |ТипРасчета,
														 |КассаККМ,
														 |Кассир,
														 |КассирИНН");
	
	ОбщиеПараметры.Свойство("ПокупательEmail", ПокупательEmail);
	Если ОбщиеПараметры.Свойство("ПокупательНомер") И ЗначениеЗаполнено(ОбщиеПараметры.ПокупательНомер) Тогда
		ПокупательНомер = СтрЗаменить(ОбщиеПараметры.ПокупательНомер, "+7", "");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КассаККМ) И ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьКассуККМЧекаКоррекцииПоУмолчанию(Организация, КассаККМ);
	КонецЕсли;
	
	СНОКорректируемогоДокумента = ОбщиеПараметры.СистемаНалогообложения;
	Если ЗначениеЗаполнено(ОбщиеПараметры.Получатель) Тогда
		Контрагент = ОбщиеПараметры.Получатель;
	Иначе
		Контрагент = ОбщиеПараметры.СведенияОПокупателе.Покупатель;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОбщиеПараметры.ПолучательИНН) Тогда
		КонтрагентИНН = ОбщиеПараметры.ПолучательИНН;
	Иначе
		КонтрагентИНН = ОбщиеПараметры.СведенияОПокупателе.ПокупательИНН;
	КонецЕсли;
	ПризнакАгента = ОбщиеПараметры.ПризнакАгента;
	
	// Позиции чека
	
	// При создании Чека коррекции на основании Чека коррекции НеприменениеККТ, ТЧ ПозицииЧека
	// заполнятся из документа основания, т.к. XML в формате 1.05 не содержит достаточной информации 
	// для формирования Чека коррекции.
	
	ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьПозицииЧекаКоррекцииНаОсновании(ФискальнаяОперация.ДокументОснование, ОбщиеПараметры, ПозицииЧека);
	
	// Оплаты
	Для Каждого СтрокаОплаты Из ОбщиеПараметры.ТаблицаОплат Цикл
		
		НоваяСтрока = Оплата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОплаты);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеФискальнойОперации(Основание)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не ЗначениеЗаполнено(Основание) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ФискальнаяОперация = НоваяСтруктураФискальнаяОперация();
	ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьДанныеФискальнойОперацииЧекаКоррекцииНаОсновании(ФискальнаяОперация, Основание);
	Возврат ФискальнаяОперация;
	
КонецФункции

Функция НоваяСтруктураФискальнаяОперация()
	
	ФискальнаяОперация = Новый Структура;
	ФискальнаяОперация.Вставить("ДатаКоррекции");
	ФискальнаяОперация.Вставить("ДокументОснование");
	ФискальнаяОперация.Вставить("ДокументРасчетов");
	ФискальнаяОперация.Вставить("ФискальныйПризнак");
	ФискальнаяОперация.Вставить("Организация");
	ФискальнаяОперация.Вставить("СтруктурнаяЕдиница");
	ФискальнаяОперация.Вставить("ТипРасчета");
	ФискальнаяОперация.Вставить("ДанныеXML");
	ФискальнаяОперация.Вставить("ОбщиеПараметры");
	ФискальнаяОперация.Вставить("ЕстьКорректирующийДокумент", Ложь);
	ФискальнаяОперация.Вставить("ПредставлениеКорректирующегоДокумента");
	
	Возврат ФискальнаяОперация;
	
КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли