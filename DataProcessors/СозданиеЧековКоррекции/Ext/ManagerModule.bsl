#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Создаёт 2 чека коррекции: сторно и корректный чек
//
// Параметры:
//  Контекст - данные обработки Создание чеков коррекции 
// 
// Возвращаемое значение:
//   Структура - cодержит свойства:
//     * ЧекКоррекцииСторно - ДокументСсылка.ЧекКоррекции - чек коррекции сторно.
//     * ЧекКоррекции - ДокументСсылка.ЧекКоррекции - чек коррекции.
//
Функция СоздатьЧекиКоррекции(Контекст) Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("ЧекКоррекцииСторно");
	Результат.Вставить("ЧекСкорректированный");
	
	ФормироватьЧекСторно = ЗначениеЗаполнено(Контекст.ДокументОснование)
							И Не Контекст.НеприменениеККТ               // Чек основание был пробит.
							И Контекст.ТипКоррекции <> 2                // Если попал в карантин "Самостоятельно, чек не принят ФНС" - сторно не делается.
							И НЕ ЗначениеЗаполнено(Контекст.ЧекСторно); // Чек сторно еще не сформирован.
	
	Если ФормироватьЧекСторно Тогда
		РезультатЧекСторно = Неопределено;
		ОбщегоНазначенияРМКПереопределяемый.ЧекКоррекцииСторно(Контекст, РезультатЧекСторно);
		Если РезультатЧекСторно <> Неопределено Тогда
			Результат.ЧекКоррекцииСторно = РезультатЧекСторно;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Контекст.ЧекСкорректированный) Тогда
		РезультатЧек = Неопределено;
		ОбщегоНазначенияРМКПереопределяемый.ЧекКоррекции(Контекст, РезультатЧек);
		Если РезультатЧек <> Неопределено Тогда
			Результат.ЧекСкорректированный = РезультатЧек;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли